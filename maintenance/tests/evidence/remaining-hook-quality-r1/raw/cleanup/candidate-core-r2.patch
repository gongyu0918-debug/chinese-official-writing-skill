+def _host_abort_marker_path(record_path: Path) -> Path:
+    return record_path.with_suffix(".host-abort")
+
+
+def _pending_host_abort(record_path: Path) -> str | None:
+    try:
+        reason = _host_abort_marker_path(record_path).read_text(encoding="utf-8").strip()
+    except OSError:
+        return None
+    return reason if reason in HOST_ABORT_REASONS else "adapter_failure"
+
+
+def _mark_host_abort(record_path: Path, reason: str) -> None:
+    # Cancellation must survive a busy state lock without retaining request/draft text.
+    marker = _host_abort_marker_path(record_path)
+    marker.parent.mkdir(parents=True, exist_ok=True)
+    try:
+        with marker.open("x", encoding="utf-8", newline="\n") as handle:
+            handle.write(reason + "\n")
+    except FileExistsError:
+        pass
+

{
  "description": "Route one private outline subagent before drafting and run one outline-compliance pass before delivery.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/outline_prompt_hook.py\"",
            "commandWindows": "py -3 \"${PLUGIN_ROOT}/scripts/outline_prompt_hook.py\"",
            "timeout": 10,
            "statusMessage": "Preparing the private fact-placement outline"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "spawn_agent|multi_agent_v1wait_agent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/outline_prompt_hook.py\"",
            "commandWindows": "py -3 \"${PLUGIN_ROOT}/scripts/outline_prompt_hook.py\"",
            "timeout": 10,
            "statusMessage": "Freezing the returned outline"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/scripts/outline_prompt_hook.py\"",
            "commandWindows": "py -3 \"${PLUGIN_ROOT}/scripts/outline_prompt_hook.py\"",
            "timeout": 10,
            "statusMessage": "Checking the draft against the frozen outline"
          }
        ]
      }
    ]
  }
}

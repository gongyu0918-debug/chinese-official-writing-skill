        "UserPromptSubmit",
        "PostToolUse:Bash|Read|Skill",
        "Stop"
      ],
      "required_stop_field": "last_assistant_message",
      "data_root_environment": "CODEBUDDY_PLUGIN_DATA",
      "continuation_limit": 4
    },
    "claude_code": {
      "status": "lifecycle_verified",
      "adapter_source": "hooks/adapters/claude-code",

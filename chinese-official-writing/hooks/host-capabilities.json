    "uncertain_authority_action": "preserve_original"
  },
  "delivery_cleanliness_gate": {
    "status": "candidate",
    "activation": "explicit_static_companion_selection",
    "configuration_file": "hook-capability.json",
    "default_selected": false,
    "operation": "delete_unrequested_delivery_wrappers_only",

    "automatic_installation": false,
    "network_access": false,
    "task_opt_out_supported": true,
    "task_opt_out_record": "bypass=user_requested"
  },
  "length_gate": {
    "automatic_expansion": true,
    "automatic_compression": false,
    "status": "candidate",

    "network_exfiltration": false
  },
  "length_gate": {
    "automatic_expansion": true,
    "automatic_compression": false,
    "status": "available_opt_in",
    "activation": "explicit_static_companion_selection",
    "configuration_file": "hook-capability.json",
    "default_selected": false,
    "trigger": "explicit_lower_bound_and_more_than_ten_percent_short",
    "revision_limit": 1,
    "failure_action": "original_draft"
  },
  "over_length_gate": {
    "status": "available_opt_in",
    "automatic_compression": true,
    "activation": "explicit_static_companion_selection",
    "configuration_file": "hook-capability.json",
    "default_selected": false,
    "trigger": "explicit_upper_bound_and_more_than_ten_percent_over",
    "sequence": [
      "semantic_repetition_observation",
      "bounded_compression",
      "semantic_verdict",
      "hash_bound_delivery"
    ],
    "compression_limit": 2,
    "failure_action": "original_draft"
  },
  "protective_expansion_gate": {
    "status": "available_opt_in",
    "activation": "explicit_static_companion_selection",
    "configuration_file": "hook-capability.json",
    "default_selected": false,
    "operation": "delete_exact_spans_only",
    "source_visibility": "request_and_observed_tool-read boundary",
    "uncertain_authority_action": "preserve_original"
  },
  "delivery_cleanliness_gate": {
    "status": "available_opt_in",
    "activation": "explicit_static_companion_selection",
    "configuration_file": "hook-capability.json",
    "default_selected": false,
    "operation": "delete_unrequested_delivery_wrappers_only",
    "revision_limit": 1,
    "verdict_limit": 1,
    "failure_action": "original_draft"
  },
  "repetition_cleanup_gate": {
    "status": "available_opt_in",
    "activation": "explicit_static_companion_selection",
    "configuration_file": "hook-capability.json",
    "default_selected": false,
    "operation": "delete_semantically_redundant_frozen_spans_only",
    "exact_duplicate_action": "candidate_only",
    "high_similarity_action": "semantic_observation_required",
    "failure_action": "original_draft"
  },

{
  "schema_version": 2,
  "shared_gate_core": "chinese-official-writing/scripts/review_gate.py",
  "activation": {
    "default": "disabled",
    "ordinary_skill_install_enables_hooks": false,
    "configuration_mutation": "forbidden"
  },
  "hosts": {
    "codex": {
      "status": "repository_companion_verified",
      "adapter": "repository-root hooks/hooks.json",
      "package_presence": {
        "repository_companion": "present",
        "skillhub_ordinary_package": "adapter_absent"
      },
      "skillhub_activation": "requires_user_authorized_host_glue",
      "events": [
        "UserPromptSubmit",
        "PostToolUse:Bash",
        "Stop"
      ],
      "data_root_environment": "COW_GATE_HOOK_DATA or PLUGIN_DATA",
      "continuation_limit": 4
    },
    "claude_code": {
      "status": "lifecycle_verified",
      "adapter": "hooks/claude-code",
      "package_presence": "package_present",
      "events": [
        "UserPromptSubmit",
        "PostToolUse:Bash|Read",
        "Stop"
      ],
      "events_with_known_support": [
        "UserPromptSubmit",
        "PostToolUse:Read",
        "Stop"
      ],
      "events_requiring_compatibility_check": [
        "PostToolUse:Bash"
      ],
      "first_party_login_required": false,
      "data_root_environment": "CLAUDE_PLUGIN_DATA",
      "minimum_version": "2.1.195",
      "continuation_limit": 4,
      "activation": "explicit plugin load only"
    },
    "openclaw": {
      "status": "frozen",
      "adapter": null
    },
    "workbuddy": {
      "status": "unknown",
      "adapter": null
    }
  }
}

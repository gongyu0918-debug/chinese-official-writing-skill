{
  "description": "Packaged opt-in Claude Code lifecycle adapter for the bounded delivery gate; it does not change host configuration.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py -3 -c \"import os,runpy,sys;os.environ['CLAUDE_PLUGIN_ROOT']=sys.argv[1];os.environ['CLAUDE_PLUGIN_DATA']=sys.argv[2];runpy.run_path(os.path.join(sys.argv[1],'scripts','gate_stop_hook.py'),run_name='__main__')\" \"${CLAUDE_PLUGIN_ROOT}\" \"${CLAUDE_PLUGIN_DATA}\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Read",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 -c \"import os,runpy,sys;os.environ['CLAUDE_PLUGIN_ROOT']=sys.argv[1];os.environ['CLAUDE_PLUGIN_DATA']=sys.argv[2];runpy.run_path(os.path.join(sys.argv[1],'scripts','gate_stop_hook.py'),run_name='__main__')\" \"${CLAUDE_PLUGIN_ROOT}\" \"${CLAUDE_PLUGIN_DATA}\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py -3 -c \"import os,runpy,sys;os.environ['CLAUDE_PLUGIN_ROOT']=sys.argv[1];os.environ['CLAUDE_PLUGIN_DATA']=sys.argv[2];runpy.run_path(os.path.join(sys.argv[1],'scripts','gate_stop_hook.py'),run_name='__main__')\" \"${CLAUDE_PLUGIN_ROOT}\" \"${CLAUDE_PLUGIN_DATA}\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}

{
  "schema_version": 3,
  "shared_gate_core": "chinese-official-writing/scripts/review_gate.py",
  "activation": {
    "default": "disabled",
    "ordinary_skill_install_enables_hooks": false,
    "configuration_mutation": "forbidden"
  },
  "hosts": {
    "codex": {
      "status": "package_registration_verified",
      "adapter": ".codex-plugin/plugin.json + hooks/hooks.json + hooks/host_gate_adapter.py",
      "package_presence": {
        "repository_companion": "present",
        "skillhub_ordinary_package": "companion_present_inactive"
      },
      "skillhub_activation": "explicit_plugin_install_enable_and_hook_trust",
      "events": [
        "UserPromptSubmit",
        "PostToolUse:Bash|Read",
        "Stop"
      ],

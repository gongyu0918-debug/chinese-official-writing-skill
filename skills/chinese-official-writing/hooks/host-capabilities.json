      "live_lifecycle_verified": false,
      "data_root_environment": "COW_GATE_HOOK_DATA or PLUGIN_DATA",
      "continuation_limit": 4
    },
    "claude_code": {
      "status": "lifecycle_verified",
      "adapter": "hooks/claude-code",
      "package_presence": "package_present",
      "events": [
        "UserPromptSubmit",
        "PostToolUse:Bash|Read",
        "Stop"
      ],
      "verified_events": [
        "UserPromptSubmit",
        "PostToolUse:Read",
        "Stop"
      ],
      "unverified_events": [
        "PostToolUse:Bash"
      ],
      "verified_transport": "anthropic_messages_gateway",
      "verified_model": "ollama-cloud/deepseek-v4-flash:0731",
      "first_party_login_required": false,
      "data_root_environment": "CLAUDE_PLUGIN_DATA",
      "minimum_version": "2.1.195",
      "continuation_limit": 4,
      "activation": "explicit plugin load only"
    },
    "openclaw": {
      "status": "frozen",
      "adapter": null
    },
    "workbuddy": {
      "status": "package_manifest_verified",
      "adapter": ".codebuddy-plugin/plugin.json + hooks/hooks.json + hooks/host_gate_adapter.py",
      "package_presence": "companion_present_inactive",
      "events": [
        "UserPromptSubmit",
        "PostToolUse:Bash|Read",
        "Stop"
      ],
      "verified_scope": "official_cli_manifest_validation_and_local_binary_contract_inspection_without_model",
      "live_lifecycle_verified": false,
      "locally_inspected_host_version": "WorkBuddy 5.3.8 / CodeBuddy Code 2.115.0",
      "minimum_documented_hook_version": "CodeBuddy Code 1.16.0",
      "required_stop_field": "last_assistant_message",
      "data_root_environment": "CODEBUDDY_PLUGIN_DATA",
      "continuation_limit": 4,
      "activation": "explicit plugin load only"
    }
  }
}
